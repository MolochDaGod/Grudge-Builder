# ============================================
# Grudge Warlords — Production Environment
# ============================================
# Copy to .env and fill in real values.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/grudge_warlords

# ── Auth / Sessions ───────────────────────────
# JWT_SECRET must match the Cloudflare Workers JWT_SECRET
JWT_SECRET=change-me-to-a-random-64-char-string
SESSION_SECRET=change-me-to-another-random-string

# ── Crossmint (cNFT Minting + Wallets) ───────
# Get keys from https://www.crossmint.com/console
CROSSMINT_SERVER_API_KEY=sk_production_...
CROSSMINT_COLLECTION_ID=your-character-collection-id
CROSSMINT_ISLAND_CNFT=your-island-template-id
# Set to 'true' to use staging.crossmint.com instead of production
# CROSSMINT_USE_STAGING=false

# ── AI (Avatar + Sprite Generation) ──────────
# Used by server-side avatar generation. Can also route through AI Gateway.
OPENAI_API_KEY=sk-...
# Optional: override base URL (e.g. for AI Gateway proxy)
# OPENAI_BASE_URL=https://ai.grudge-studio.com/v1
# Auth token for AI Gateway (if routing server calls through it)
# GRUDGE_AUTH_TOKEN=your-grudge-jwt

# ── Discord OAuth ─────────────────────────────
DISCORD_CLIENT_ID=1471046591220678677
DISCORD_CLIENT_SECRET=your-discord-client-secret

# ── Admin ─────────────────────────────────────
ADMIN_PASSWORD=your-admin-password
ADMIN_API_KEY=your-admin-api-key

# ── Object Storage (Puter) ────────────────────
# DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-id

# ── Google Sheets (Game Data) ─────────────────
# GOOGLE_SERVICE_ACCOUNT_EMAIL=...@...iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_KEY=base64-encoded-key
# GOOGLE_SHEET_WEAPONS=spreadsheet-id
# GOOGLE_SHEET_ARMOR=spreadsheet-id
# GOOGLE_SHEET_ITEMS=spreadsheet-id
# GOOGLE_SHEET_CHEF=spreadsheet-id
# GOOGLE_SHEET_CRAFTING=spreadsheet-id

# ── Supabase (@supabase/server) ───────────────
# Copy real values from Dashboard → Connect. Never commit the secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Remote JWKS for JWT verification (used when SUPABASE_JWKS inline JSON is unset)
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Telegram (@grudachainbot) + GBUX on Solana ─
TELEGRAM_BOT_ADMIN_KEY=shared-secret-with-grudachain-ale
GBUX_MINT_ADDRESS=55TpSoMNxbfsNJ9U1dQoo9H3dRtDmjBZVMcKqvU2nray
GBUX_DECIMALS=6
GBUX_TREASURY_SECRET_KEY=base58-or-json-keypair-holding-gbux-spl
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# ── Cloudflare R2 (S3 API — grudge-assets bucket) ─
# Dashboard → R2 → Manage R2 API Tokens
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_ASSETS=grudge-assets
OBJECT_STORAGE_PUBLIC_URL=https://assets.grudge-studio.com

# ── Deployment ────────────────────────────────
NODE_ENV=production
PORT=5000
