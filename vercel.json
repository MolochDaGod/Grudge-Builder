{
  "alias": ["client.grudge-studio.com", "grudgewarlords.com", "www.grudgewarlords.com"],
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "devCommand": "npm run dev:client",
  "installCommand": "npm install --ignore-scripts --legacy-peer-deps",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/account/:path*",
      "destination": "https://account.grudge-studio.com/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/api/oauth-google",
      "destination": "https://id.grudge-studio.com/auth/google/start"
    },
    {
      "source": "/api/oauth-google/callback",
      "destination": "https://id.grudge-studio.com/auth/google/callback"
    },
    {
      "source": "/api/oauth-github",
      "destination": "https://id.grudge-studio.com/auth/github/start"
    },
    {
      "source": "/api/oauth-github/callback",
      "destination": "https://id.grudge-studio.com/auth/github/callback"
    },
    {
      "source": "/api/discord-login",
      "destination": "https://id.grudge-studio.com/auth/discord/start"
    },
    {
      "source": "/api/discord-login/callback",
      "destination": "https://id.grudge-studio.com/auth/discord/callback"
    },
    {
      "source": "/api/login",
      "destination": "https://id.grudge-studio.com/auth/login"
    },
    {
      "source": "/api/register",
      "destination": "https://id.grudge-studio.com/auth/register"
    },
    {
      "source": "/api/guest",
      "destination": "https://id.grudge-studio.com/auth/puter"
    },
    {
      "source": "/api/wallet",
      "destination": "https://api.grudge-studio.com/wallet"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "https://api.grudge-studio.com/wallet/:path*"
    },
    {
      "source": "/api/island/:path*",
      "destination": "https://api.grudge-studio.com/island/:path*"
    },
    {
      "source": "/api/nfts/:path*",
      "destination": "https://api.grudge-studio.com/nfts/:path*"
    },
    {
      "source": "/api/nfts",
      "destination": "https://api.grudge-studio.com/nfts"
    },
    {
      "source": "/api/island-nfts/:path*",
      "destination": "https://api.grudge-studio.com/island-nfts/:path*"
    },
    {
      "source": "/api/island-nfts",
      "destination": "https://api.grudge-studio.com/island-nfts"
    },
    {
      "source": "/api/professions/:path*",
      "destination": "https://api.grudge-studio.com/professions/:path*"
    },
    {
      "source": "/api/inventory/:path*",
      "destination": "https://api.grudge-studio.com/inventory/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://api.grudge-studio.com/health"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://api.grudge-studio.com/characters/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://api.grudge-studio.com/characters"
    },
    {
      "source": "/api/party",
      "destination": "https://api.grudge-studio.com/party"
    },
    {
      "source": "/api/party/:path*",
      "destination": "https://api.grudge-studio.com/party/:path*"
    },
    {
      "source": "/api/tools/:path*",
      "destination": "https://api.grudge-studio.com/tools/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/game/:path*",
      "destination": "https://api.grudge-studio.com/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://api.grudge-studio.com/public/:path*"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/editor",
      "headers": [
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "require-corp"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
