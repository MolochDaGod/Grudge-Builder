{
  "buildCommand": "cd client && npx vite build",
  "outputDirectory": "client/dist",
  "devCommand": "npm run dev:client",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/auth/:path*",
      "destination": "https://grudgewarlords.com/api/auth/:path*"
    },
    {
      "source": "/api/discord/:path*",
      "destination": "https://grudgewarlords.com/api/discord/:path*"
    },
    {
      "source": "/api/game/:path*",
      "destination": "https://grudgewarlords.com/api/game/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://grudgewarlords.com/api/public/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
