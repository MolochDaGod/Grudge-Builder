{
  "alias": ["client.grudge-studio.com", "grudgewarlords.com", "www.grudgewarlords.com"],
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "devCommand": "npm run dev:client",
  "installCommand": "npm install --ignore-scripts",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/account/:path*",
      "destination": "https://api.grudge-studio.com/api/account/:path*"
    },
    {
      "source": "/api/auth/:path*",
      "destination": "https://id.grudge-studio.com/auth/:path*"
    },
    {
      "source": "/api/discord-login",
      "destination": "https://id.grudge-studio.com/auth/discord?redirect_uri=https://grudgewarlords.com"
    },
    {
      "source": "/api/oauth-google",
      "destination": "https://id.grudge-studio.com/auth/google?redirect_uri=https://grudgewarlords.com"
    },
    {
      "source": "/api/oauth-github",
      "destination": "https://id.grudge-studio.com/auth/github?redirect_uri=https://grudgewarlords.com"
    },
    {
      "source": "/api/login",
      "destination": "https://id.grudge-studio.com/auth/login"
    },
    {
      "source": "/api/register",
      "destination": "https://id.grudge-studio.com/auth/register"
    },
    {
      "source": "/api/guest",
      "destination": "https://id.grudge-studio.com/auth/guest"
    },
    {
      "source": "/api/wallet",
      "destination": "https://api.grudge-studio.com/api/wallet"
    },
    {
      "source": "/api/wallet/:path*",
      "destination": "https://api.grudge-studio.com/api/wallet/:path*"
    },
    {
      "source": "/api/island/:path*",
      "destination": "https://api.grudge-studio.com/api/island/:path*"
    },
    {
      "source": "/api/nfts/:path*",
      "destination": "https://api.grudge-studio.com/api/nfts/:path*"
    },
    {
      "source": "/api/nfts",
      "destination": "https://api.grudge-studio.com/api/nfts"
    },
    {
      "source": "/api/island-nfts/:path*",
      "destination": "https://api.grudge-studio.com/api/island-nfts/:path*"
    },
    {
      "source": "/api/island-nfts",
      "destination": "https://api.grudge-studio.com/api/island-nfts"
    },
    {
      "source": "/api/professions/:path*",
      "destination": "https://api.grudge-studio.com/api/professions/:path*"
    },
    {
      "source": "/api/inventory/:path*",
      "destination": "https://api.grudge-studio.com/api/inventory/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://api.grudge-studio.com/api/health"
    },
    {
      "source": "/api/characters/:path*",
      "destination": "https://api.grudge-studio.com/api/characters/:path*"
    },
    {
      "source": "/api/characters",
      "destination": "https://api.grudge-studio.com/api/characters"
    },
    {
      "source": "/api/party",
      "destination": "https://api.grudge-studio.com/api/party"
    },
    {
      "source": "/api/party/:path*",
      "destination": "https://api.grudge-studio.com/api/party/:path*"
    },
    {
      "source": "/api/tools/:path*",
      "destination": "https://api.grudge-studio.com/tools/:path*"
    },
    {
      "source": "/api/assets/:path*",
      "destination": "https://assets.grudge-studio.com/:path*"
    },
    {
      "source": "/api/game/:path*",
      "destination": "https://api.grudge-studio.com/api/:path*"
    },
    {
      "source": "/api/public/:path*",
      "destination": "https://api.grudge-studio.com/public/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
