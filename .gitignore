# Vendored monorepo (CI clone for native /world)
vendor/grudge-character-animator/

# Dependencies
node_modules/
.venv/
.conda/

# Build artifacts
dist/
build/
target/
server/public/

# Large binary assets
*.zip
*.psd
*.ai
*.exe
*.mpq
*.tar.gz
*.blend
*.eps
*.glb
*.gltf
*.fbx
*.obj
*.stl

# Allow public model assets (GLTF + textures, but NOT .bin — too large for git)
!public/models/**/*.gltf
!public/models/**/*.png
!public/models/**/*.jpg
# scene.bin files are loaded at runtime but stored outside git (object storage / local)
public/models/**/*.bin

# Attached/generated assets (not needed for build)
attached_assets/

# Secrets
.env
.env.local
.env.production

# Dev environment
.config/
.local/
.vercel/
.wrangler/

# Crash dumps
hs_err_pid*.log
replay_pid*.log

# IDE
.DS_Store
.ipynb_checkpoints/
.history/

# Diablo web reference
diabloweb/

# Vite config temps
vite.config.ts.*
.vercel

# Large model files (served from ObjectStore R2 CDN, not git)
public/models/*.glb
public/models/*.fbx
public/models/*.obj
.env*.local

# Town GLB assets (too large for git, served from R2 CDN in prod)
public/models/towns/**/*.glb
public/models/instances/**/*.glb
# Temp files
D:/*.ts
.env.local
scripts/pull-railway-db.mjs

*.log

# Playwright
test-results/
playwright-report/
blob-report/
