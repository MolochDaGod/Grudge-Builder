# Grudge Builder — npm config
# ──────────────────────────────────────────────────────
# Avoid peer dep conflicts across the large mixed dep tree
legacy-peer-deps=true

# Skip native compile scripts (node-gyp, etc.) during install.
# Packages like node-gyp, canvas, or sharp try to compile C++ bindings
# which fail on Node 24 or in CI. --ignore-scripts bypasses this.
# Individual scripts (postinstall for drizzle-kit etc.) still run via npm run.
ignore-scripts=false

# Increase network timeout for large installs (default 60000)
fetch-timeout=120000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=3

# Don't fund prompt
fund=false

# Reduce noise
loglevel=warn
