# Local development sample. Copy to .env or .env.local (both are gitignored).
# These are labeled placeholders only — never real secrets.
# The server does not ship these strings as defaults. It refuses to start
# if SESSION_SECRET or JWT_SECRET is missing or whitespace-only, in every
# environment. Use the same value for both if the island server should
# accept JWTs issued by the API.

SESSION_SECRET=dev-only-change-me-not-a-real-secret
JWT_SECRET=dev-only-change-me-not-a-real-secret
