# ==============================================
# GRUDGE BUILDER - Environment Variables
# ==============================================

# Server Configuration
NODE_ENV=development  # development | production
PORT=5000
LOG_LEVEL=info  # debug | info | warn | error

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/grudge_builder

# Session Management
SESSION_SECRET=your-session-secret-here-change-this-in-production

# ==============================================
# AI PROVIDERS
# ==============================================

# OpenAI (Primary AI Provider)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1  # Optional: use for proxies
AI_INTEGRATIONS_OPENAI_API_KEY=  # Alternative env var name
AI_INTEGRATIONS_OPENAI_BASE_URL=  # Alternative env var name

# ==============================================
# AUTHENTICATION & SECURITY
# ==============================================

# Admin Access
ADMIN_PASSWORD=change-this-admin-password

# ==============================================
# WALLET & BLOCKCHAIN
# ==============================================

# Crossmint (NFT & Wallet Minting) - REQUIRED for wallet features
CROSSMINT_API_KEY=  # Required: Primary API key for NFT minting
CROSSMINT_SERVER_API_KEY=  # Required: Server-side API key for wallet creation
CROSSMINT_USE_STAGING=false  # Optional: Set to 'true' for testing with Crossmint staging

# Solana (Required for wallet & NFT features)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com  # Solana RPC endpoint

# ==============================================
# FIREBASE (Optional - Auth & Firestore)
# ==============================================

# Firebase Web App Config (from Firebase Console)
VITE_FIREBASE_API_KEY=           # Client-side Firebase API key
VITE_FIREBASE_AUTH_DOMAIN=       # e.g. your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=        # Firebase project ID
VITE_FIREBASE_STORAGE_BUCKET=    # e.g. your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-side Firebase vars (same values, used by server/firebase.ts)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ==============================================
# GOOGLE SERVICES (Optional)
# ==============================================

# Google Sheets Integration (Optional)
GOOGLE_SHEET_WEAPONS=  # Optional: weapons data sheet ID
GOOGLE_SHEET_ARMOR=  # Optional: armor data sheet ID
GOOGLE_SHEET_CHEF=  # Optional: chef items sheet ID
GOOGLE_SHEET_ITEMS=  # Optional: items sheet ID
GOOGLE_SERVICE_ACCOUNT_JSON=  # Optional: service account credentials (JSON string)

# ==============================================
# FEATURE FLAGS
# ==============================================

# Feature Toggles
ENABLE_AI_FEATURES=true  # Enable/disable AI personality generation
ENABLE_NFT_FEATURES=false  # Enable/disable NFT minting
ENABLE_WALLET_FEATURES=true  # Enable/disable automatic wallet creation
ENABLE_GOOGLE_SHEETS=false  # Enable/disable Google Sheets sync

# ==============================================
# DEVELOPMENT TOOLS
# ==============================================

# Development Mode Settings
VITE_DEV_PORT=5000  # Vite development server port
DEBUG=  # Optional: debug module patterns (e.g., 'app:*')

# ==============================================
# NOTES
# ==============================================

# Copy this file to .env and fill in your actual values
# Never commit .env to version control
#
# REQUIRED VARIABLES:
#   - DATABASE_URL (PostgreSQL connection string)
#   - SESSION_SECRET (random 32+ character string)
#   - OPENAI_API_KEY (for AI character generation)
#
# REQUIRED FOR WALLET FEATURES:
#   - CROSSMINT_SERVER_API_KEY (from crossmint.com/console)
#   - CROSSMINT_API_KEY (from crossmint.com/console)
#   - SOLANA_RPC_URL (default provided)
#
# All other variables are optional depending on features used
#
# To generate SESSION_SECRET:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
