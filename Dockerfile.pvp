# ── Grudge World Server — Docker image ──────────────────────────────────────
# World Socket.IO server (port 4321).
# Runs standalone with tsx (no build step needed for simple deploys).
# For production, prefer: npm run build:world && npm run start:world
#
# Build:  docker build -f Dockerfile.pvp -t grudge-world .
# Run:    docker run -p 4321:4321 --env-file .env grudge-world

FROM node:22-alpine AS base

WORKDIR /app

# Install only the deps needed by island-server
COPY package.json package-lock.json ./

RUN npm install --legacy-peer-deps --ignore-scripts --omit=dev \
    && npm install --legacy-peer-deps --ignore-scripts --save-dev tsx typescript @types/node

# ── Build stage ──────────────────────────────────────────────────────────────
FROM base AS builder

COPY server/island-server.ts ./server/
COPY server/cors.ts ./server/
COPY tsconfig.json ./

RUN npx esbuild server/island-server.ts \
    --bundle \
    --platform=node \
    --format=cjs \
    --outfile=dist/world-server.cjs \
    --packages=external \
    --minify

# ── Final stage ──────────────────────────────────────────────────────────────
FROM node:22-alpine AS final

WORKDIR /app

# Only runtime deps
COPY package.json package-lock.json ./
RUN npm install --legacy-peer-deps --ignore-scripts --omit=dev

COPY --from=builder /app/dist/world-server.cjs ./dist/

EXPOSE 4321

ENV NODE_ENV=production
ENV WORLD_PORT=4321

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD wget -qO- http://localhost:4321/health || exit 1

CMD ["node", "dist/world-server.cjs"]
